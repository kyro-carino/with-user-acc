# Copy to ".env" (same folder as index.html) and fill in. ".env" is private and git-ignored.
# Placeholders only: never put real secrets in this example file.

APP_ENV=development                 # development | production (anything else is treated as production)

# Database
DB_HOST=localhost
DB_PORT=3307                        # XAMPP default; some installs use 3307
DB_NAME=feu_library
DB_USER=root                        # production refuses root: use a dedicated least-privilege user
DB_PASS=                            # production requires a password

# Development only: password for the auto-created "admin" account (12+ chars; no "admin", "password", "12345")
DEV_ADMIN_PASSWORD=replace-with-a-private-password

# Production only (all optional)
# TRUSTED_PROXIES=10.0.0.5          # comma-separated proxy IPs whose X-Forwarded-Proto is trusted (TLS behind a proxy)
# ALLOW_INSECURE_HTTP=1             # NOT recommended: allows plain HTTP in production
# SETUP_TOKEN=                      # 24+ random chars enables web first-run setup; prefer: php tools/create_admin.php
# CORS_ALLOW_ORIGIN=                # only if the frontend is served from a different origin